---
// Two dialogs opened by «Записатися» / «Подзвонити» / «Написати». Without JS the same triggers jump to #kliniky.
import Icon from "./Icon.astro";
import { CLINICS, HOURS, TELEGRAM } from "../data/site";
const leo = CLINICS[0];
---
<dialog class="sheet" id="sheet-call" aria-labelledby="sheet-call-title" data-rec="R-202">
  <div class="sheet__in">
    <div class="sheet__head">
      <h2 id="sheet-call-title" class="sheet__title">Оберіть клініку</h2>
      <button type="button" class="sheet__close" data-sheet-close><Icon name="close" /><span class="visually-hidden">Закрити</span></button>
    </div>
    <ul class="sheet__list">
      {CLINICS.map((c) => (
        <li class="sheet__clinic">
          <h3 class="sheet__street">{c.street}</h3>
          <p class="sheet__hours">{HOURS}</p>
          <a class="btn btn--primary sheet__tel" href={`tel:${c.tel}`}><Icon name="phone" /><span>Подзвонити <span class="num">{c.phone}</span></span></a>
          <p class="sheet__msg">
            {c.viber && <a class="text-link" href={c.viber}>Viber</a>}
            <a class="text-link" href={TELEGRAM} rel="noopener" target="_blank">Telegram</a>
          </p>
        </li>
      ))}
    </ul>
  </div>
</dialog>

<dialog class="sheet" id="sheet-write" aria-labelledby="sheet-write-title">
  <div class="sheet__in">
    <div class="sheet__head">
      <h2 id="sheet-write-title" class="sheet__title">Написати в месенджер</h2>
      <button type="button" class="sheet__close" data-sheet-close><Icon name="close" /><span class="visually-hidden">Закрити</span></button>
    </div>
    <ul class="sheet__list sheet__list--write">
      <li class="sheet__clinic">
        <h3 class="sheet__street">Telegram</h3>
        <p class="sheet__hours">Обидві клініки, @elites_dental</p>
        <a class="btn btn--primary sheet__tel" href={TELEGRAM} rel="noopener" target="_blank"><Icon name="chat" /><span>Написати в Telegram</span></a>
      </li>
      <li class="sheet__clinic">
        <h3 class="sheet__street">Viber</h3>
        <p class="sheet__hours">Клініка на {leo.street}</p>
        <a class="btn btn--outline sheet__tel" href={leo.viber}><Icon name="chat" /><span>Написати у Viber</span></a>
      </li>
    </ul>
  </div>
</dialog>
